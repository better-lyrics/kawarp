{
  "name": "@kawarp/core",
  "version": "1.3.1",
  "description": "Fluid animated background renderer using WebGL, Kawase blur, and domain warping",
  "keywords": [
    "webgl",
    "blur",
    "kawase",
    "animation",
    "background",
    "canvas",
    "graphics"
  ],
  "license": "MIT",
  "author": "Better Lyrics",
  "homepage": "https://github.com/better-lyrics/kawarp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-lyrics/kawarp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/better-lyrics/kawarp/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@kawarp/core-baseline": "npm:@kawarp/core@1.2.2",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@vitest/browser-playwright": "5.0.2",
    "playwright": "1.63.0",
    "typescript": "5.9.2",
    "vitest": "5.0.2"
  }
}
